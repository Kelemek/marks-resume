---
import type { ResumeData } from '../lib/types';
import CertIcon from './CertIcon.astro';

type CertificateEntry = ResumeData['certificates'][number];

interface Props {
  cert: CertificateEntry;
  variant?: 'default' | 'nested';
}

const { cert, variant = 'default' } = Astro.props;

const cardClass =
  variant === 'nested'
    ? 'scrimba-cert-card card-lift bg-bg-tertiary rounded-2xl p-5 border border-border flex justify-between items-center gap-4'
    : 'card-lift bg-bg-secondary rounded-2xl p-5 border border-border flex justify-between items-center gap-4';

const buttonClass =
  variant === 'nested'
    ? 'cert-button focus-ring btn-interactive flex items-center gap-2 px-4 py-2 bg-bg-secondary text-text-secondary rounded-lg border border-border cursor-pointer text-sm hover:bg-accent hover:text-white hover:border-accent'
    : 'cert-button focus-ring btn-interactive flex items-center gap-2 px-4 py-2 bg-bg-tertiary text-text-secondary rounded-lg border border-border cursor-pointer text-sm hover:bg-accent hover:text-white hover:border-accent';
---

<div class={cardClass}>
  <div class="flex-1 min-w-0">
    <h3 class="text-base font-semibold text-text-primary mb-1">{cert.title}</h3>
    <p class="text-sm text-text-muted">{cert.institution}</p>
  </div>
  {cert.pdfPath && (
    <button
      class={buttonClass}
      data-cert={cert.pdfPath}
      aria-label={cert.ariaLabel || `View ${cert.title}`}
    >
      <CertIcon />
      <span class="cert-text">View</span>
    </button>
  )}
</div>
