---
import { resumeIdentity } from '../lib/resumeIdentity';
---

<section id="contact" class="py-16 md:py-20 bg-bg-secondary text-center">
  <div class="max-w-6xl mx-auto px-4 md:px-8">
    <h2 class="text-2xl md:text-3xl font-bold text-text-primary mb-8 pb-4 border-b border-border relative inline-block after:content-[''] after:absolute after:bottom-[-2px] after:left-1/2 after:-translate-x-1/2 after:w-16 after:h-1 after:bg-accent">Get in Touch</h2>
    <p class="text-lg text-text-secondary mb-8 max-w-xl mx-auto">
      The quickest way to reach me is via email. I will do my best to respond&nbsp;promptly.
    </p>
    <div class="flex flex-col items-center gap-4">
      <a href={`mailto:${resumeIdentity.email}`} class="inline-block px-8 py-4 bg-bg-tertiary text-text-primary no-underline rounded-md font-medium transition-all duration-300 hover:bg-accent hover:text-white hover:-translate-y-px">{resumeIdentity.email}</a>
      <div class="flex flex-wrap justify-center gap-4 text-text-muted">
        <a href={`tel:${resumeIdentity.phoneTel}`} class="text-text-muted no-underline hover:text-accent transition-colors duration-300">{resumeIdentity.phone}</a>
        <a href={`http://maps.apple.com/?q=${resumeIdentity.addressMapsQuery}`} class="text-text-muted no-underline hover:text-accent transition-colors duration-300">{resumeIdentity.address}</a>
      </div>
    </div>
  </div>
</section>
