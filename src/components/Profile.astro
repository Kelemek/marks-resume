---
import type { ResumeSectionProps } from '../lib/types';
import { calculateITExperience } from '../lib/experience';
import {
  profileSummaryLead,
  profileSummaryParagraph2,
  profileSummaryParagraph3,
} from '../lib/profileSummary';

const { resumeData } = Astro.props as ResumeSectionProps;
const experienceYears = calculateITExperience(resumeData.itStartYear);
---

<section id="profile" class="py-12 md:py-10 bg-bg-secondary">
  <div class="max-w-6xl mx-auto px-4 md:px-8">
    <h2 class="heading-section text-2xl md:text-3xl font-bold text-text-primary mb-8 pb-4 border-b border-border relative after:content-[''] after:absolute after:bottom-[-2px] after:left-0 after:w-16 after:h-1 after:bg-accent">Professional Profile</h2>
    <div class="prose-readable text-text-secondary leading-relaxed space-y-4">
      <p>
        {profileSummaryLead.beforeYears}<span id="experience-years" class="tabular-nums">{experienceYears}</span>+{profileSummaryLead.afterYears}
      </p>
      <p>{profileSummaryParagraph2}</p>
      <p>{profileSummaryParagraph3}</p>
    </div>
  </div>
</section>
