---
import type { ResumeSectionProps } from '../lib/types';
import { calculateITExperience } from '../lib/experience';
import { toAtsDownloadPayload } from '../lib/atsDownload';
import { resumeIdentity } from '../lib/resumeIdentity';

const { resumeData } = Astro.props as ResumeSectionProps;
const experienceYears = calculateITExperience(resumeData.itStartYear);
const clientData = JSON.stringify(toAtsDownloadPayload(resumeData));
---

<section id="top" class="py-16 md:py-24 text-center bg-bg-primary">
  <div class="max-w-6xl mx-auto px-4 md:px-8">
    <h1 class="heading-section text-4xl md:text-6xl font-bold text-text-primary mb-4 tracking-tight text-balance">{resumeIdentity.fullName}</h1>
    <p class="text-lg md:text-xl text-text-muted mb-8 max-w-xl mx-auto text-pretty">
      A {resumeIdentity.professionalRole} with <span id="hero-experience-years" class="tabular-nums">{experienceYears}</span>+ years of experience based in {resumeIdentity.locationShort}.
    </p>
    <div class="mt-8 flex gap-4 justify-center flex-wrap">
      <a href={`mailto:${resumeIdentity.email}`} class="focus-ring btn-interactive motion-safe-nudge inline-block px-8 py-4 bg-bg-tertiary text-text-primary no-underline rounded-md font-medium hover:bg-accent hover:text-white">Get in touch</a>
      <button id="downloadPDF" class="focus-ring btn-interactive motion-safe-nudge px-8 py-4 bg-bg-tertiary text-text-primary rounded-md font-medium border-none cursor-pointer font-inherit text-base hover:bg-accent hover:text-white disabled:opacity-70 disabled:cursor-not-allowed disabled:transform-none">Download Resume</button>
    </div>
  </div>
</section>

<script define:vars={{ clientData }}>
  window.atsResumeData = JSON.parse(clientData);
</script>
